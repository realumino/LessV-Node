#!/sbin/openrc-run
# LessV node reconciler (Alpine/OpenRC).
#
# WHY supervise-daemon: it restarts the reconciler on failure and keeps the
# pidfile the heartbeat's xray_pid/uptime checks rely on, without requiring
# the OpenRC `start-stop-daemon` background mode.
description="LessV node reconciler (Xray config and certificate convergence)"
supervisor="supervise-daemon"
command="/usr/local/bin/lessv-node"
command_args="run --config /etc/lessv/node.toml"
command_user="root:root"
pidfile="/run/lessv-node.pid"
output_log="/var/log/lessv-node.log"
error_log="/var/log/lessv-node.log"
# Match the systemd unit; the reconciler is not the fd hog, but the
# ceiling is cheap and keeps both supervisors consistent.
rc_ulimit="-n 1000000"
respawn_delay=5
respawn_max=0

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /var/log
}
