#!/sbin/openrc-run
# Xray under OpenRC (Alpine), managed by lessv-node.
#
# WHY supervise-daemon: the reconciler restarts Xray through
# `rc-service xray restart`, and supervise-daemon both reparents the process
# and writes /run/xray.pid, which the node reports in its heartbeat.
description="Xray Service (managed by lessv-node)"
supervisor="supervise-daemon"
# GeoIP/GeoSite data managed by lessv-node (routing rules name geoip:/geosite:).
export XRAY_LOCATION_ASSET=/var/lib/lessv/assets
command="/usr/local/bin/xray"
command_args="run -config /var/lib/lessv/config.json"
command_user="root:root"
pidfile="/run/xray.pid"
output_log="/var/log/xray.log"
error_log="/var/log/xray.log"
# One fd per proxied connection (plus the listener); the systemd unit
# carries the same ceiling. cloud-init nodes also raise fs.file-max.
rc_ulimit="-n 1000000"
respawn_delay=5
respawn_max=0

depend() {
    need net
    # REALITY relays handshakes to the decoy's Unix socket, which nginx
    # creates: start it first (and start it if it is not running).
    after firewall nginx
    want nginx
}

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /var/log
}
