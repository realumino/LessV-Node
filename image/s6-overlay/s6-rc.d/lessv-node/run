#!/command/with-contenv sh
# WHAT: the reconciler, held back until this node has been enrolled.
# WHY the guard: `lessv-node run` exits 2 without /etc/lessv/node.toml, and s6
# would restart it in a tight loop -- a log flood where the operator needs one
# instruction instead. Enrolling from a second shell writes the file and this
# service starts on its own, no restart needed.
if [ ! -f /etc/lessv/node.toml ]; then
    echo "lessv-node: /etc/lessv/node.toml is missing; enroll this node first:"
    echo "lessv-node:   docker run --rm -it --entrypoint /usr/local/bin/lessv-node \\"
    echo "lessv-node:     -v lessv-etc:/etc/lessv <this-image> enroll \\"
    echo "lessv-node:       --cp <control-plane-url> --node <node-id> \\"
    echo "lessv-node:       --restart-mode s6 --nginx-conf-path /etc/nginx/http.d/lessv-decoy.conf"
    echo "lessv-node: (node token on stdin; this service starts once the file exists)"
    while [ ! -f /etc/lessv/node.toml ]; do sleep 10; done
    echo "lessv-node: /etc/lessv/node.toml appeared; starting the reconciler"
fi
exec /usr/local/bin/lessv-node run --config /etc/lessv/node.toml
